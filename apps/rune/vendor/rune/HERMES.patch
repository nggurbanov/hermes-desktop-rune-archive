+impl Windows {
+    fn cleanup(&mut self, event_loop: &ActiveEventLoop) {
+        self.spawn_pending(event_loop);
+        self.hosts.retain(|_, host| {
+            if host.finished() { host.cancel_menus(); false } else { true }
